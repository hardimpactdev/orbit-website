{
    "schema_version": 1,
    "repository": "nckrtl/orbit-website",
    "base_branch": "main",
    "mode": "pr-only",
    "automerge": false,
    "deploy": false,
    "ordinary_age_days": 7,
    "security_bypasses_age_only": true,
    "allowed_update_types": ["patch", "minor"],
    "runner_labels": ["self-hosted", "linux", "x64", "sabre", "orbit-website-maintenance-isolated"],
    "required_stages": ["php", "analysis", "frontend", "build", "browser"],
    "test_stages": ["php", "browser"],
    "maximum_command_seconds": 600,
    "maximum_infrastructure_retries": 2,
    "test_retries": 0,
    "maximum_correction_rounds": 3,
    "quarantine_label": "maintenance-quarantined",
    "notification_mode": "receipt-only",
    "production_tests": false,
    "executor": "docker-no-host-mounts",
    "required_workflow_job": "maintenance-gate",
    "proof_seal": "hmac-sha256-host-only"
}
