{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": ["composer", "npm"],
  "baseBranchPatterns": ["main"],
  "branchPrefix": "maintenance/",
  "draftPR": true,
  "automerge": false,
  "platformAutomerge": false,
  "minimumReleaseAge": "7 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "prCreation": "immediate",
  "prConcurrentLimit": 1,
  "prHourlyLimit": 1,
  "branchConcurrentLimit": 1,
  "recreateWhen": "never",
  "rebaseWhen": "never",
  "stopUpdatingLabel": "maintenance-quarantined",
  "ignoreScripts": true,
  "ignorePlugins": true,
  "dependencyDashboard": false,
  "rangeStrategy": "in-range-only",
  "lockFileMaintenance": {"enabled": false},
  "packageRules": [
    {"matchUpdateTypes": ["major", "replacement", "rollback", "pin", "digest", "pinDigest"], "enabled": false}
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "minimumReleaseAge": "0 days",
    "minimumReleaseAgeBehaviour": "timestamp-required",
    "automerge": false,
    "draftPR": true,
    "prConcurrentLimit": 1,
    "labels": ["maintenance-security"]
  },
  "prBodyNotes": [
    "PR-only pilot. No automatic merge or deployment. Security bypasses release age only.",
    "Maintenance evidence must show full PHP tests, analysis, frontend checks, client/SSR build and explicit browser tests at this head.",
    "On failure the existing PR is quarantined. Do not reopen/recreate unchanged candidates or relax tests to get green."
  ]
}
